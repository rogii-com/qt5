+
+    *target = targetTransform(clippedDeviceRect, deviceWindowRect, invertTargetY);
+
+    // A texture widget renders into size() * dpr pixels, while its target spans the rounded
+    // device edges; at a fractional dpr the two differ by a pixel depending on the position.
+    // Fitting the texture onto the target resamples it with Nearest filtering and drops or
