+    const QSize slack = textureSize - deviceRect.size();
+    if (!textureSize.isEmpty() && qAbs(slack.width()) <= 1 && qAbs(slack.height()) <= 1) {
+        const QRect texels(clippedDeviceRect.topLeft() - deviceRect.topLeft(), clippedDeviceRect.size());
+        *source = sourceTransform(toBottomLeftRect(texels, textureSize.height()), textureSize, origin);
+        return true;
+    }
 
