+    QRect deviceWindowRect = scaledRect(QRect(QPoint(), window->size()), dpr);
+    QRect sourceWindowRect = scaledRect(QRect(QPoint(), window->size()), sourceDevicePixelRatio);
+    // The native surface size is not always representable as window->size() * dpr
