set(
    QT_DEFAULT_PACKAGE
    "@DEFAULT_PACKAGE@"
)

set(
    QT_ASSERTS_PACKAGE
    "@ASSERTS_PACKAGE@"
)

set(
    QT_PACKAGE_VARIANT
    "${QT_DEFAULT_PACKAGE}"
)

if(QT_FORCE_ASSERTS)
    if(NOT QT_ASSERTS_PACKAGE)
        message(
            FATAL_ERROR
            "QT_FORCE_ASSERTS: this Qt package has no asserts variant for the platform."
        )
    endif()

    # The asserts variant holds the release configuration only.
    get_property(
        QT_IS_MULTI_CONFIG
        GLOBAL
        PROPERTY
            GENERATOR_IS_MULTI_CONFIG
    )

    if(QT_IS_MULTI_CONFIG OR CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(
            FATAL_ERROR
            "QT_FORCE_ASSERTS: the Qt asserts variant has no Debug configuration, so it needs a single-configuration generator and a build type other than Debug."
        )
    endif()

    set(
        QT_PACKAGE_VARIANT
        "${QT_ASSERTS_PACKAGE}"
    )
endif()

# This file is included from CNPM_PREPARE_PACKAGES, whose scope holds its settings under the
# ${P} prefix; the variant is fetched and included right away, so Qt is ready before the
# packages declared after it.
NPM_PREPARE_PACKAGE(
    PACKAGE_NAME
        ${QT_PACKAGE_VARIANT}
    REPOSITORY_URLS
        ${${P}REPOSITORY_URLS}
    FORCE
        ${${P}FORCE}
    ROOT
        ${${P}ROOT}
    TMP
        ${${P}TMP}
    ARCHIVE_TYPE
        7z
)

message(
    STATUS
    "Qt package variant: ${QT_PACKAGE_VARIANT}"
)

include("${${P}ROOT}/${QT_PACKAGE_VARIANT}/package.cmake")

unset(
    QT_DEFAULT_PACKAGE
)

unset(
    QT_ASSERTS_PACKAGE
)

unset(
    QT_PACKAGE_VARIANT
)

unset(
    QT_IS_MULTI_CONFIG
)
